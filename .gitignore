/target
**/*.rs.bk
.idea
.vscode
*.iml
.DS_Store
*.err
/*.py
# Scratch / diagnostic logs
*.log
*_test_*.txt
test_*_core.txt
io*.log
snap*.log
test_stdout.txt
test_stderr.txt
/checklist.pdf
/README.pdf

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
# Debug symbols emitted beside the extension module by `maturin develop`.
*.pdb

# Windows reserved-name artifact (accidental 'nul' redirection)
nul

# Local agent tooling state
.mimocode/

# Claude agent per-machine state (lock files, linked-worktree lanes); never
# the shared agent memory under .claude/agent-memory/, which is tracked
# project configuration.
.claude/scheduled_tasks.lock
.claude/worktrees/

# Fetched SimpleITK ExternalData test corpus (downloaded on demand)
externals/

scratch/
/dist/
/output/

# Local host toolchain overlay (machine-specific paths)
.cargo/config.toml

# Per-machine agent state: harness locks, subagent memory, managed worktrees.
# A CI checkout has none of it, so it is this machine's, not the repository's.
.claude/
